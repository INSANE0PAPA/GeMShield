# GeMShield — Root Environment Configuration
# Copy this file to .env and fill in your values

# ─── Neon PostgreSQL (Application Database) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Supabase Auth ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend Supabase vars (must start with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ─── data.gov.in ────────────────────────────────────────────────────────────
DATA_GOV_API_KEY=your-data-gov-api-key

# ─── Backend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ─── Demo Accounts (created in Supabase Auth) ──────────────────────────────
# admin@gemshield.demo / GemShieldAdmin@2026!
# vendor@gemshield.demo / GemShieldVendor@2026!
